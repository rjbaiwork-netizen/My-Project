DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
PORT="4000"
NODE_ENV="production"
CORS_ORIGIN="https://my-project-mk2x.onrender.com"

# AI Provider Router
# Ordered failover chain. Only configured providers are used.
AI_PROVIDER_ORDER="openai,gemini,groq,mistral"

# OpenAI purpose-specific keys already used by My-Project.
# My-Project Knowledge=
# My-Project AI Agent=
# My-Project Production AI=
OPENAI_API_KEY=

# Free-tier-capable fallback provider examples.
GEMINI_API_KEY=
GEMINI_KNOWLEDGE_MODEL="gemini-3.8-flash"
GEMINI_AGENT_MODEL="gemini-3.8-flash"
GEMINI_PRODUCTION_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

GROQ_API_KEY=
GROQ_KNOWLEDGE_MODEL="openai/gpt-oss-120b"
GROQ_AGENT_MODEL="openai/gpt-oss-120b"
GROQ_PRODUCTION_MODEL="openai/gpt-oss-120b"

# Optional OpenAI-compatible providers can be added without code changes.
# JSON must contain id, name, keyEnv, baseUrl, models and capabilities.
AI_PROVIDER_REGISTRY_JSON='[{"id":"example","name":"Example Provider","keyEnv":"EXAMPLE_API_KEY","baseUrl":"https://api.example.com/v1","models":{"production":"example-model"},"capabilities":["chat","agent","content"],"freeTier":true}]'

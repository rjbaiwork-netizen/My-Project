DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
PORT="4000"
NODE_ENV="production"
CORS_ORIGIN="https://my-project-mk2x.onrender.com"

# AI Provider Router
AI_PROVIDER_ORDER="openai,gemini,groq,mistral,openrouter"
GEMINI_API_KEY=
GEMINI_KNOWLEDGE_MODEL="gemini-3.8-flash"
GEMINI_AGENT_MODEL="gemini-3.8-flash"
GEMINI_PRODUCTION_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
GROQ_API_KEY=
GROQ_KNOWLEDGE_MODEL="openai/gpt-oss-120b"
GROQ_AGENT_MODEL="openai/gpt-oss-120b"
GROQ_PRODUCTION_MODEL="openai/gpt-oss-120b"
AI_PROVIDER_REGISTRY_JSON=


# Provider Plugin & Credential Automation
# These bootstrap credentials are infrastructure secrets; never commit their values.
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
RENDER_API_KEY=
RENDER_SERVICE_ID=
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_REDIRECT_URI=
OPENROUTER_MANAGEMENT_KEY=

OPENROUTER_API_KEY=
OPENROUTER_KNOWLEDGE_MODEL="openrouter/free"
OPENROUTER_AGENT_MODEL="openrouter/free"
OPENROUTER_PRODUCTION_MODEL="openrouter/free"

# Dedicated Telegram TOTPS Bot — separate from any Expert Brain / notifications bot.
ADMIN_API_TOKEN=
TELEGRAM_TOTPS_BOT_TOKEN=
BOT_TELEGRAM_USERNAME=@TOTPS_Bot
BOT_TELEGRAM_USER_ID=
OWNER_TELEGRAM_USERNAME=
OWNER_TELEGRAM_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

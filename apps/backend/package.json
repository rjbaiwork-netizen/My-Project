{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && npm run build --workspace=@my-project/shared && tsc",
    "start": "npm run db:migrate:deploy && npm run db:seed && tsx src/server.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:security": "node --import tsx --test src/middleware/adminAuth.test.ts src/lib/confirmationStore.test.ts ../../apps/frontend/lib/loginRateLimit.test.ts ../../apps/frontend/lib/adminSession.test.ts ../../apps/frontend/app/api/ai/\\[...path\\]/route.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "2.8.5",
    "dotenv": "^17.2.2",
    "express": "5.1.0",
    "pg": "8.23.0",
    "@my-project/shared": "1.0.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}

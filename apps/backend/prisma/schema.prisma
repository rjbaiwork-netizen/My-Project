generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SectionKey {
  HEADER
  HERO
  ABOUT
  SERVICES
  PORTFOLIO
  PRICING
  TESTIMONIALS
  BLOG
  CONTACT
  FOOTER
}

model CMSSection {
  id        String     @id @default(cuid())
  key       SectionKey @unique
  title     String
  content   Json
  isVisible Boolean    @default(true)
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isVisible])
  @@index([order])
  @@index([isVisible, order])
}


enum AIAgentStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum AIJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model AIAgent {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  description String
  systemPrompt String
  status      AIAgentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        AIAgentRun[]
  jobs        AIJob[]
}

model AIConversation {
  id        String       @id @default(cuid())
  title     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  messages  AIMessage[]
  memories  AIMemory[]
}

model AIMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime        @default(now())
  conversation   AIConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model AIMemory {
  id             String          @id @default(cuid())
  conversationId String?
  namespace      String          @default("default")
  content        String
  metadata       Json?
  embedding      Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([namespace, createdAt])
}

model AIKnowledgeDocument {
  id         String   @id @default(cuid())
  title      String
  content    String
  source     String?
  metadata   Json?
  embedding  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([createdAt])
}

model AIAgentRun {
  id        String       @id @default(cuid())
  agentId   String
  status    AIJobStatus  @default(QUEUED)
  input     Json?
  output    Json?
  error     String?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime     @default(now())
  agent     AIAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@index([agentId, createdAt])
}

model AIJob {
  id          String       @id @default(cuid())
  agentId     String?
  type        String
  payload     Json
  status      AIJobStatus  @default(QUEUED)
  scheduledAt DateTime?
  attempts    Int          @default(0)
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  agent       AIAgent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  @@index([status, scheduledAt])
  @@index([agentId, createdAt])
}

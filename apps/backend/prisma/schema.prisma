generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SectionKey {
  HEADER
  HERO
  ABOUT
  SERVICES
  PORTFOLIO
  PRICING
  TESTIMONIALS
  BLOG
  CONTACT
  FOOTER
}

model CMSSection {
  id        String     @id @default(cuid())
  key       SectionKey @unique
  title     String
  content   Json
  isVisible Boolean    @default(true)
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isVisible])
  @@index([order])
  @@index([isVisible, order])
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SectionKey {
  HEADER
  HERO
  ABOUT
  SERVICES
  PORTFOLIO
  PRICING
  TESTIMONIALS
  BLOG
  CONTACT
  FOOTER
}

model CMSSection {
  id        String     @id @default(cuid())
  key       SectionKey @unique
  title     String
  content   Json
  isVisible Boolean    @default(true)
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isVisible])
  @@index([order])
  @@index([isVisible, order])
}


enum AIAgentStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum AIJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model AIAgent {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  description String
  systemPrompt String
  status      AIAgentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        AIAgentRun[]
  jobs        AIJob[]
  brainCategories AIAgentBrainCategory[]
  automations AIAutomation[]
}

model AIConversation {
  id        String       @id @default(cuid())
  title     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  messages  AIMessage[]
  memories  AIMemory[]
  agentLinks AIAgentMemory[]
}

model AIMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime        @default(now())
  conversation   AIConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model AIMemory {
  id             String          @id @default(cuid())
  conversationId String?
  namespace      String          @default("default")
  content        String
  metadata       Json?
  embedding      Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([namespace, createdAt])
  agentLinks AIAgentMemory[]
}

model AIAgentMemory {
  id String @id @default(cuid())
  agentId String
  memoryId String
  categoryId String?
  agent AIAgent @relation(fields:[agentId],references:[id],onDelete:Cascade)
  memory AIMemory @relation(fields:[memoryId],references:[id],onDelete:Cascade)
  category AIAgentBrainCategory? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  @@unique([agentId,memoryId])
  @@index([agentId,categoryId])
}

model AIKnowledgeDocument {
  id         String   @id @default(cuid())
  title      String
  content    String
  source     String?
  metadata   Json?
  embedding  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([createdAt])
  agentLinks AIAgentKnowledge[]
}

model AIAgentKnowledge {
  id String @id @default(cuid())
  agentId String
  knowledgeId String
  categoryId String?
  agent AIAgent @relation(fields:[agentId],references:[id],onDelete:Cascade)
  knowledge AIKnowledgeDocument @relation(fields:[knowledgeId],references:[id],onDelete:Cascade)
  category AIAgentBrainCategory? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  @@unique([agentId,knowledgeId])
  @@index([agentId,categoryId])
}

model AIAgentRun {
  id        String       @id @default(cuid())
  agentId   String
  status    AIJobStatus  @default(QUEUED)
  input     Json?
  output    Json?
  error     String?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime     @default(now())
  agent     AIAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@index([agentId, createdAt])
}

model AIJob {
  id          String       @id @default(cuid())
  agentId     String?
  type        String
  payload     Json
  status      AIJobStatus  @default(QUEUED)
  scheduledAt DateTime?
  attempts    Int          @default(0)
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  agent       AIAgent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  @@index([status, scheduledAt])
  @@index([agentId, createdAt])
}



enum AIAutomationStatus {
  ACTIVE
  PAUSED
  DRAFT
}

model AIAgentBrainCategory {
  id          String   @id @default(cuid())
  agentId     String
  key         String
  name        String
  description String?
  progress    Int      @default(0)
  dataCount   Int      @default(0)
  memoryCount Int      @default(0)
  knowledgeCount Int    @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  agent       AIAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  metrics     AIBrainMetric[]
  @@unique([agentId, key])
  @@index([agentId, updatedAt])
}

model AIBrainMetric {
  id         String   @id @default(cuid())
  categoryId String
  metricDate DateTime @default(now())
  progress   Int
  dataCount  Int      @default(0)
  memoryCount Int     @default(0)
  knowledgeCount Int  @default(0)
  category   AIAgentBrainCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@index([categoryId, metricDate])
}

model AIAutomation {
  id          String             @id @default(cuid())
  name        String
  description String?
  status      AIAutomationStatus @default(DRAFT)
  trigger     Json
  conditions  Json?
  actions     Json
  agentId     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  agent       AIAgent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  runs        AIAutomationRun[]
  @@index([status, updatedAt])
  @@index([agentId, updatedAt])
}

model AIAutomationRun {
  id           String       @id @default(cuid())
  automationId String
  status       AIJobStatus  @default(QUEUED)
  input        Json?
  output       Json?
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime     @default(now())
  automation   AIAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  @@index([automationId, createdAt])
}

NEXT_PUBLIC_API_URL="https://YOUR-RAILWAY-BACKEND.up.railway.app"

# Required on the Render frontend service for admin session validation and backend proxy.
# Set the same random ADMIN_API_TOKEN value in the backend runtime. Never commit real values.
ADMIN_API_TOKEN="must-match-the-Railway-backend-ADMIN_API_TOKEN"
ADMIN_CONTROL_PROXY_ENABLED="false"
